*.xib.generated.swift
*.storyboard.generated.swift

# ──────────────────────────────────────────────────────────────
# Swift Package Manager
# ──────────────────────────────────────────────────────────────
.build/
.swiftpm/
Packages/
Package.pins
*.xcodeproj/project.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/

# Package.resolved 정본은 Architecture.xcworkspace/xcshareddata/swiftpm/ 하나로 통일.
# 그 외의 위치(로컬 패키지·xcodeproj 내장 워크스페이스)는 SPM 이 자동 재생성하는
# 부산물이므로 추적하지 않는다.
ArchitecturePackage/Package.resolved
Architecture.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved

